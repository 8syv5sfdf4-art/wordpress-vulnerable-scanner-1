# Copy to .env (git-ignored) and fill in. Real environment variables
# override the values in this file.

# Base URL of your DefectDojo instance
DEFECTDOJO_URL=https://defectdojo.example.com
# API v2 token: DefectDojo > your profile > API v2 Key
DEFECTDOJO_API_KEY=

# Where the findings go. Product defaults to the site folder name.
#DEFECTDOJO_PRODUCT=example.com
#DEFECTDOJO_PRODUCT_TYPE=Web Application
#DEFECTDOJO_ENGAGEMENT=example.com audit
#DEFECTDOJO_TEST_TITLE_PREFIX=
